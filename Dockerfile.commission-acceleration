FROM golang:1.26.10-bookworm@sha256:632dff7351799a5a9954a48dc06670ade72ee44e8c351cdc0e5a57af2fea21af AS build
WORKDIR /src
ENV GOTOOLCHAIN=local GOMAXPROCS=2 GOFLAGS="-p=1"
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod,id=cosmos-tax-sdk-go-mod go mod download
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod,id=cosmos-tax-sdk-go-mod \
    --mount=type=cache,target=/root/.cache/go-build,id=cosmos-tax-sdk-go-build \
    CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w" -o /out/taxcommissionaccelerate ./taxcommissionaccelerate
FROM ghcr.io/bryanlabs/cosmos-tax-sdk:commission-page-ca668b6-20261118@sha256:6bc242963447b7061b912420598a828571f1c65d8f43416a2d2d9d398cc70d67
COPY --from=build /out/taxcommissionaccelerate /usr/local/bin/taxcommissionaccelerate
ARG SOURCE_COMMIT
LABEL org.opencontainers.image.revision=$SOURCE_COMMIT
LABEL cosmos-tax.native-source="ca668b6842184f52f583f79b01c89fcf9ca4033c"
LABEL cosmos-tax.native-binary-sha256="d169a6ae23f8c1934b25e227af8cab6e3b76bf6a87b5103b0dc7011c3f77c988"
USER tax
ENTRYPOINT ["/usr/local/bin/taxcommissionaccelerate"]
