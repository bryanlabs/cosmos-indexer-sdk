FROM golang:1.26.10-bookworm@sha256:632dff7351799a5a9954a48dc06670ade72ee44e8c351cdc0e5a57af2fea21af AS build
WORKDIR /src
ENV GOTOOLCHAIN=local GOMAXPROCS=2 GOMEMLIMIT=512MiB GOFLAGS="-p=1"
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod,id=cosmos-tax-sdk-go-mod go mod download
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod,id=cosmos-tax-sdk-go-mod \
    --mount=type=cache,target=/root/.cache/go-build,id=cosmos-tax-sdk-go-build \
    CGO_ENABLED=0 GOOS=linux GOARCH=amd64 nice -n 15 taskset -c 0-1 go build -trimpath -ldflags="-s -w" -o /out/taxcommissionaccelerate ./taxcommissionaccelerate
FROM ghcr.io/bryanlabs/cosmos-tax-sdk:query-fix-wrapper-b76dbf4-56808b1-20261115@sha256:2c9eaa53d21b104df307924c1d06275f5cf4535496ae71594fe7012090d75a55
COPY --from=build /out/taxcommissionaccelerate /usr/local/bin/taxcommissionaccelerate
ARG SOURCE_COMMIT
LABEL org.opencontainers.image.revision=$SOURCE_COMMIT
LABEL cosmos-tax.wrapper-source=$SOURCE_COMMIT
LABEL cosmos-tax.native-source="b76dbf4c11a2a47985ade933d0c0fad554c077a8"
LABEL cosmos-tax.native-binary-sha256="8ab0b0a9cafdc564a3399c42e05805ba922409e59eb9226398e218f68f0e99a5"
USER tax
ENTRYPOINT ["/usr/local/bin/taxcommissionaccelerate"]
